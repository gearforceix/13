<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GEAR_FORCE_9 // LEVEL_UP_SIM</title>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg-color: #080a0f;
      --panel-bg: #0f141c;
      --accent-cyan: #00f3ff;
      --accent-green: #00ff66;
      --accent-red: #ff0055;
      --text-muted: #4a5568;
      --border-color: #1e293b;
      --font-tech: 'Fira Code', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: #a0aec0;
      font-family: var(--font-tech);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 2rem 1rem;
    }

    .terminal-wrapper {
      background-color: var(--panel-bg);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      box-shadow: 0 0 30px rgba(0, 243, 255, 0.05);
      padding: 1.5rem;
      width: 850px;
      max-width: 95vw;
    }

    .terminal-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.75rem;
      margin-bottom: 1rem;
      letter-spacing: 1px;
    }

    .sys-status .blink_me {
      color: var(--accent-cyan);
      animation: blinker 1.5s linear infinite;
    }

    @keyframes blinker {
      50% { opacity: 0; }
    }

    .viewport-container {
      position: relative;
      background-color: #030712;
      border: 1px solid #1e293b;
      border-radius: 4px;
    }

    canvas {
      display: block;
      width: 100%;
      height: auto;
    }

    .telemetry {
      position: absolute;
      top: 15px;
      left: 15px;
      right: 15px;
      display: flex;
      justify-content: space-between;
      pointer-events: none;
    }

    .stat-box {
      background: rgba(8, 10, 15, 0.85);
      border: 1px solid var(--border-color);
      padding: 0.4rem 0.8rem;
      border-radius: 4px;
      font-size: 0.85rem;
    }

    .stat-box .label {
      color: var(--text-muted);
      margin-right: 0.5rem;
    }

    .stat-box .value {
      color: var(--accent-cyan);
      font-weight: 600;
    }

    .controls-panel {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border-color);
    }

    .instructions {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .instructions span {
      color: var(--accent-cyan);
    }

    #startBtn {
      background: transparent;
      border: 1px solid var(--accent-cyan);
      color: var(--accent-cyan);
      font-family: var(--font-tech);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.5rem 1.25rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    #startBtn:hover {
      background: var(--accent-cyan);
      color: var(--bg-color);
      box-shadow: 0 0 12px rgba(0, 243, 255, 0.4);
    }

    /* Competition Hub Styles */
    .competition-hub {
      margin-top: 1.5rem;
      border-top: 1px solid var(--border-color);
      padding-top: 1.5rem;
      text-align: left;
    }

    .hub-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--accent-cyan);
      margin-bottom: 1rem;
    }

    .event-card {
      background: rgba(15, 20, 28, 0.6);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 1.25rem;
    }

    .event-status {
      color: var(--accent-green);
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 1rem;
      border-bottom: 1px dashed var(--border-color);
      padding-bottom: 0.5rem;
    }

    .event-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .info-line {
      margin-bottom: 0.5rem;
      font-size: 0.8rem;
    }

    .info-line .lbl {
      color: var(--text-muted);
    }

    .info-line .val {
      color: #fff;
    }

    .block-title {
      color: var(--accent-cyan);
      font-size: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .schedule-block ul {
      list-style: none;
      font-size: 0.8rem;
    }

    .schedule-block li {
      margin-bottom: 0.4rem;
      color: #a0aec0;
    }

    .schedule-block li span {
      color: var(--accent-cyan);
      margin-right: 0.5rem;
    }

    .goals-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-top: 0.5rem;
    }

    .goal-item {
      background: #080a0f;
      border: 1px solid var(--border-color);
      padding: 0.75rem;
      border-radius: 4px;
      display: flex;
      gap: 0.75rem;
    }

    .goal-num {
      color: var(--accent-red);
      font-weight: 600;
      font-size: 0.9rem;
    }

    .goal-item p {
      font-size: 0.75rem;
      color: #a0aec0;
      line-height: 1.4;
    }

    .goal-item strong {
      color: #fff;
    }

    footer {
      margin-top: 1.5rem;
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: center;
    }

    footer a {
      color: var(--accent-cyan);
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="terminal-wrapper">
    <header class="terminal-header">
      <div class="sys-id">> SYS.LOC: GEAR_FORCE_9 // VEX_IQ_CORE</div>
      <div class="sys-status">STATUS: <span class="blink_me">ONLINE</span></div>
    </header>

    <main class="viewport-container">
      <canvas id="gameCanvas" width="800" height="480"></canvas>
      
      <div class="telemetry">
        <div class="stat-box">
          <span class="label">SCORE:</span>
          <span id="score" class="value">0000</span>
        </div>
        <div class="stat-box">
          <span class="label">TIMER:</span>
          <span id="timer" class="value">60.0</span>s
        </div>
        <div class="stat-box">
          <span class="label">AMMO:</span>
          <span id="ammo" class="value">READY</span>
        </div>
      </div>
    </main>

    <div class="controls-panel">
      <div class="instructions">
        <span>[UP/DOWN]</span> THRUST &nbsp;|&nbsp; 
        <span>[LEFT/RIGHT]</span> STEER &nbsp;|&nbsp; 
        <span>[W]</span> LAUNCH BEAM_BAG
      </div>
      <button id="startBtn" onclick="startGame()">RUN_PROGRAM()</button>
    </div>

    <!-- Competition Section -->
    <section class="competition-hub">
      <div class="hub-header">
        <span class="hub-title">[ MISSION_DIRECTIVE // LEVEL_UP_SEASON ]</span>
        <span class="hub-tag">VEX_IQ_CHALLENGE</span>
      </div>

      <div class="event-card">
        <div class="event-status">> UPCOMING_EVENT: HAILEYBURY_HEROES</div>
        
        <div class="event-grid">
          <div class="event-info">
            <div class="info-line"><span class="lbl">EVENT_NAME:</span> <span class="val">Haileybury Heroes</span></div>
            <div class="info-line"><span class="lbl">LOCATION:</span> <span class="val">Haileybury Arena</span></div>
            <div class="info-line"><span class="lbl">GAME_TYPE:</span> <span class="val">VEX IQ Level Up</span></div>
          </div>

          <div class="schedule-block">
            <div class="block-title">// RUNTIME_SCHEDULE</div>
            <ul>
              <li><span>08:00</span> Pits Open & Inspection</li>
              <li><span>09:30</span> Drivers Briefing</li>
              <li><span>10:15</span> Qualification Matches</li>
              <li><span>14:00</span> Finals & Awards</li>
            </ul>
          </div>
        </div>

        <div class="goals-block">
          <div class="block-title">// TEAM_OBJECTIVES (GEAR_FORCE_9)</div>
          <div class="goals-grid">
            <div class="goal-item">
              <span class="goal-num">01</span>
              <p><strong>Autonomous Target:</strong> Execute consistent high-zone scoring routines.</p>
            </div>
            <div class="goal-item">
              <span class="goal-num">02</span>
              <p><strong>Cycle Speed:</strong> Maintain quick intake-to-launch cycles.</p>
            </div>
            <div class="goal-item">
              <span class="goal-num">03</span>
              <p><strong>Endgame Climb:</strong> Execute Level Up structure ascension.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <footer>
    CONTACT: <a href="mailto:gearforce9@outlook.com">gearforce9@outlook.com</a> | VEX IQ TEAM GEAR FORCE 9
  </footer>

  <script>
    const canvas = document.getElementById("gameCanvas");
    const ctx = canvas.getContext("2d");

    const scoreEl = document.getElementById("score");
    const timerEl = document.getElementById("timer");
    const ammoEl = document.getElementById("ammo");

    let score = 0;
    let timeLeft = 60.0;
    let gameLoopId;
    let timerInterval;
    let gameRunning = false;

    const robot = {
      x: 120,
      y: 240,
      radius: 18,
      angle: 0,
      speed: 0,
      maxSpeed: 4.5,
      rotationSpeed: 0.08,
      cooldown: 0,
    };

    const targetZone = {
      x: 640,
      y: 140,
      width: 110,
      height: 200,
    };

    let projectiles = [];
    const keys = {};

    window.addEventListener("keydown", (e) => {
      keys[e.key] = true;

      if ((e.key === "w" || e.key === "W") && gameRunning && robot.cooldown === 0) {
        shootBeamBag();
        robot.cooldown = 15;
      }
    });

    window.addEventListener("keyup", (e) => {
      keys[e.key] = false;
    });

    function shootBeamBag() {
      projectiles.push({
        x: robot.x + Math.cos(robot.angle) * 22,
        y: robot.y + Math.sin(robot.angle) * 22,
        vx: Math.cos(robot.angle) * 9,
        vy: Math.sin(robot.angle) * 9,
        radius: 5,
        active: true,
      });
    }

    function update() {
      if (!gameRunning) return;

      if (keys["ArrowLeft"]) robot.angle -= robot.rotationSpeed;
      if (keys["ArrowRight"]) robot.angle += robot.rotationSpeed;

      if (keys["ArrowUp"]) {
        robot.speed = Math.min(robot.speed + 0.25, robot.maxSpeed);
      } else if (keys["ArrowDown"]) {
        robot.speed = Math.max(robot.speed - 0.2, -robot.maxSpeed / 2);
      } else {
        robot.speed *= 0.94;
      }

      robot.x += Math.cos(robot.angle) * robot.speed;
      robot.y += Math.sin(robot.angle) * robot.speed;

      robot.x = Math.max(25, Math.min(canvas.width - 25, robot.x));
      robot.y = Math.max(25, Math.min(canvas.height - 25, robot.y));

      if (robot.cooldown > 0) {
        robot.cooldown--;
        ammoEl.innerText = "RELOADING";
        ammoEl.style.color = "#ff0055";
      } else {
        ammoEl.innerText = "READY";
        ammoEl.style.color = "#00ff66";
      }

      projectiles.forEach((p) => {
        if (!p.active) return;

        p.x += p.vx;
        p.y += p.vy;

        if (
          p.x > targetZone.x &&
          p.x < targetZone.x + targetZone.width &&
          p.y > targetZone.y &&
          p.y < targetZone.y + targetZone.height
        ) {
          score += 25;
          scoreEl.innerText = String(score).padStart(4, "0");
          p.active = false;
        }
      });
    }

    function drawGrid() {
      ctx.strokeStyle = "#0d1527";
      ctx.lineWidth = 1;

      for (let x = 0; x < canvas.width; x += 40) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, canvas.height);
        ctx.stroke();
      }
      for (let y = 0; y < canvas.height; y += 40) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(canvas.width, y);
        ctx.stroke();
      }
    }

    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      drawGrid();

      ctx.fillStyle = "rgba(0, 255, 102, 0.05)";
      ctx.fillRect(targetZone.x, targetZone.y, targetZone.width, targetZone.height);
      
      ctx.strokeStyle = "#00ff66";
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(targetZone.x, targetZone.y, targetZone.width, targetZone.height);
      ctx.setLineDash([]);

      ctx.fillStyle = "#00ff66";
      ctx.font = "11px 'Fira Code', monospace";
      ctx.fillText("[ TARGET_ZONE ]", targetZone.x + 8, targetZone.y + 20);

      projectiles.forEach((p) => {
        if (!p.active) return;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = "#ff0055";
        ctx.shadowColor = "#ff0055";
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      ctx.save();
      ctx.translate(robot.x, robot.y);
      ctx.rotate(robot.angle);

      ctx.strokeStyle = "#00f3ff";
      ctx.lineWidth = 2;
      ctx.strokeRect(-16, -16, 32, 32);

      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(20, 0);
      ctx.strokeStyle = "#00f3ff";
      ctx.lineWidth = 3;
      ctx.stroke();

      ctx.restore();
    }

    function renderLoop() {
      update();
      draw();
      if (gameRunning) {
        gameLoopId = requestAnimationFrame(renderLoop);
      }
    }

    function startGame() {
      if (gameRunning) return;

      score = 0;
      timeLeft = 60.0;
      projectiles = [];
      robot.x = 120;
      robot.y = 240;
      robot.angle = 0;

      scoreEl.innerText = "0000";
      timerEl.innerText = "60.0";
      gameRunning = true;

      cancelAnimationFrame(gameLoopId);
      clearInterval(timerInterval);

      renderLoop();

      timerInterval = setInterval(() => {
        timeLeft -= 0.1;
        timerEl.innerText = timeLeft.toFixed(1);

        if (timeLeft <= 0) {
          gameRunning = false;
          clearInterval(timerInterval);
          alert(`[SYSTEM_MSG]: Match ended. Final score: ${score}`);
        }
      }, 100);
    }
  </script>
</body>
</html>
